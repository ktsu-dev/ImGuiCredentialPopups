<Project>
  <Sdk Name="MSTest.Sdk" />
  <Sdk Name="ktsu.Sdk" />

  <PropertyGroup>
    <IsTestProject>true</IsTestProject>
    <TargetFramework>net10.0</TargetFramework>
    <TargetFrameworks></TargetFrameworks>
    <!-- The SDK folds the tests/ folder into the namespace, deriving ktsu.tests.ImGuiCredentialPopups.*,
         so these overrides stay until ktsu-dev/Sdk#37 teaches it to skip scaffolding folders. -->
    <RootNamespace>ktsu.ImGuiCredentialPopups.UITests</RootNamespace>
    <AssemblyName>$(RootNamespace)</AssemblyName>
    <EnableSourceLink>false</EnableSourceLink>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\ImGuiCredentialPopups\ImGuiCredentialPopups.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The headless harness: it drives ImGuiApp frames through a software rasterizer, so the popups
         draw with no window, no display and no GPU. -->
    <PackageReference Include="ktsu.ImGui.App.Testing" />
    <!-- For the Nerd Font ImGuiApp ships, which the gallery draws in. -->
    <PackageReference Include="ktsu.ImGui.App" />
    <PackageReference Include="ktsu.CredentialCache" />
    <PackageReference Include="ktsu.Semantics.Strings" />
    <PackageReference Include="Hexa.NET.ImGui" />
  </ItemGroup>
</Project>
